            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('All results are Hardware category', () => {",
                  "    body.content.forEach((c) => pm.expect(c.category.toLowerCase()).to.eql('hardware'));",
                  "});",
                  "const catalogItemId = pm.collectionVariables.get('catalogItemId');",
                  "pm.test('Created item appears in filtered list', () => {",
                  "    pm.expect(body.content.some((c) => c.id === catalogItemId)).to.be.true;",
                  "});"
                ]
