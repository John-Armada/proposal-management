                "catalog-items"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test Widget\",\n  \"category\": \"Hardware\",\n  \"defaultUnitPrice\": 49.99\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Has id', () => pm.expect(body.id).to.be.a('number'));",
                  "pm.test('Name matches', () => pm.expect(body.name).to.eql('Postman Test Widget'));",
                  "pm.test('Category matches', () => pm.expect(body.category).to.eql('Hardware'));",
                  "pm.test('defaultUnitPrice matches', () => pm.expect(body.defaultUnitPrice).to.eql(49.99));",
                  "pm.collectionVariables.set('catalogItemId', body.id);"
                ]
              }
            }
          ]
