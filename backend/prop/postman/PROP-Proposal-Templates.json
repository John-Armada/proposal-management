                  "pm.test('Created proposal has an id', () => pm.expect(body.id).to.exist);",
                  "pm.test('Initial status is DRAFT', () => pm.expect(body.status).to.eql('DRAFT'));",
                  "pm.collectionVariables.set('proposalId', body.id);"
                ]
              }
            }
          ]
