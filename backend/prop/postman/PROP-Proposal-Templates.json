{
  "info": {
    "_postman_id": "a8a8e0a4-47d8-4d08-9c19-2d758a5e0a21",
    "name": "PROP Full Workflow",
    "description": "End-to-end Postman collection for the currently implemented Proposal Management System API. Set the reference-data IDs before running proposal requests. Accounts, proposal requests, offerings, and categories currently have no HTTP controllers and must be seeded directly in the database.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "loginEmail",
      "value": "human.author1@company.com"
    },
    {
      "key": "loginPassword",
      "value": "Password123!"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "templateId",
      "value": ""
    },
    {
      "key": "proposalId",
      "value": ""
    },
    {
      "key": "requestId",
      "value": "1"
    },
    {
      "key": "accountId",
      "value": "1"
    },
    {
      "key": "departmentId",
      "value": "1"
    },
    {
      "key": "offeringId",
      "value": "1"
    },
    {
      "key": "categoryId",
      "value": "null"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login and save access token",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Access token is present', () => pm.expect(body.accessToken).to.be.a('string').and.not.empty);",
                  "pm.test('Token type is Bearer', () => pm.expect(body.tokenType).to.eql('Bearer'));",
                  "pm.collectionVariables.set('accessToken', body.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get current user",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Current user returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('Current user has an email', () => pm.expect(pm.response.json().email).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout and revoke token (run from Cleanup)",
          "disabled": true,
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Logout returns 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Reference Data",
      "item": [
        {
          "name": "List active departments",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/departments?activeOnly=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "departments"
              ],
              "query": [
                {
                  "key": "activeOnly",
                  "value": "true"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Departments return 200', () => pm.response.to.have.status(200));",
                  "pm.test('Departments return an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List all departments",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/departments?activeOnly=false",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "departments"
              ],
              "query": [
                {
                  "key": "activeOnly",
                  "value": "false"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Templates",
      "item": [
        {
          "name": "List templates",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/templates?page=0&size=20&sort=name,asc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "templates"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                },
                {
                  "key": "sort",
                  "value": "name,asc"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Template list returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('Template list is a page', () => pm.expect(pm.response.json()).to.have.property('content'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create template",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test Template\",\n  \"purpose\": \"Template created by the full workflow collection\",\n  \"googleDocUrl\": \"https://docs.google.com/document/d/postman-template-test/edit\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/templates",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "templates"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Template creation returns 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Created template has an id', () => pm.expect(body.id).to.exist);",
                  "pm.collectionVariables.set('templateId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get template by id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/templates/{{templateId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
