              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Proposal update returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('Proposal title was updated', () => pm.expect(pm.response.json().title).to.eql('Postman Workflow Proposal Updated'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Validation and Security Checks",
      "item": [
        {
          "name": "Reject unauthenticated template list",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/templates",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "templates"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Unauthenticated template access returns 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject invalid template URL",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Invalid URL Template\",\n  \"purpose\": \"Validation test\",\n  \"googleDocUrl\": \"https://example.com/not-a-google-doc\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/templates",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "templates"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid template URL returns 400', () => pm.response.to.have.status(400));"
                ]
