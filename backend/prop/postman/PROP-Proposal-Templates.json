                "v1",
                "templates",
                "{{templateId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Template lookup returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('Template id matches variable', () => pm.expect(String(pm.response.json().id)).to.eql(String(pm.collectionVariables.get('templateId'))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update template",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test Template Updated\",\n  \"purpose\": \"Updated template purpose\",\n  \"googleDocUrl\": \"https://docs.google.com/document/d/postman-template-test/edit\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/templates/{{templateId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "templates",
                "{{templateId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Template update returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('Template name was updated', () => pm.expect(pm.response.json().name).to.eql('Postman Test Template Updated'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete template (run from Cleanup)",
          "disabled": true,
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/v1/templates/{{templateId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
            {
              "name": "6. Cleanup",
              "item": [
                {
                  "name": "Delete template",
                  "request": {
                    "method": "DELETE",
                    "url": {
                      "raw": "{{baseUrl}}/api/v1/templates/{{templateId}}",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "api",
                        "v1",
                        "templates",
                        "{{templateId}}"
                      ]
                    }
                  },
                  "event": [
                    {
                      "listen": "test",
                      "script": {
                        "type": "text/javascript",
                        "exec": [
                          "pm.test('Template deletion returns 204', () => pm.response.to.have.status(204));"
                        ]
                      }
                    }
                  ]
                },
                {
                  "name": "Logout and revoke token",
                  "request": {
                    "method": "POST",
                    "header": [
                      {
                        "key": "Authorization",
                        "value": "Bearer {{accessToken}}"
                      }
                    ],
                    "url": {
                      "raw": "{{baseUrl}}/api/auth/logout",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "api",
                        "auth",
                        "logout"
                      ]
                    }
                  },
                  "event": [
                    {
                      "listen": "test",
                      "script": {
                        "type": "text/javascript",
                        "exec": [
                          "pm.test('Logout returns 204', () => pm.response.to.have.status(204));"
                        ]
                      }
                    }
                  ]
                }
              ]
            },
                "api",
                "v1",
                "templates",
                "{{templateId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Template deletion returns 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Proposals",
      "item": [
        {
          "name": "List proposals",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/proposals?page=0&size=20&sort=contractValue,desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "proposals"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                },
                {
                  "key": "sort",
                  "value": "contractValue,desc"
                },
                {
                  "key": "status",
                  "value": "DRAFT",
                  "disabled": true
                },
                {
                  "key": "departmentId",
                  "value": "{{departmentId}}",
                  "disabled": true
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Proposal list returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('Proposal list is a page', () => pm.expect(pm.response.json()).to.have.property('content'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create proposal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": {{requestId}},\n  \"accountId\": {{accountId}},\n  \"templateId\": {{templateId}},\n  \"title\": \"Postman Workflow Proposal\",\n  \"description\": \"Proposal created to verify the authoring flow.\",\n  \"googleDocUrl\": \"https://docs.google.com/document/d/postman-proposal-test/edit\",\n  \"contractValue\": 125000.00,\n  \"projectDuration\": 12,\n  \"totalResources\": 5,\n  \"categoryId\": {{categoryId}},\n  \"departmentId\": {{departmentId}},\n  \"offeringId\": {{offeringId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/proposals",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "proposals"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Proposal creation returns 201', () => pm.response.to.have.status(201));",
