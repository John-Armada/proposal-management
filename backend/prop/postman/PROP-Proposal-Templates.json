            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Workflow Proposal Updated\",\n  \"description\": \"Updated proposal metadata.\",\n  \"googleDocUrl\": \"https://docs.google.com/document/d/postman-proposal-test/edit\",\n  \"contractValue\": 135000.00,\n  \"projectDuration\": 14,\n  \"totalResources\": 6,\n  \"categoryId\": {{categoryId}},\n  \"departmentId\": {{departmentId}},\n  \"offeringId\": {{offeringId}}\n}"
