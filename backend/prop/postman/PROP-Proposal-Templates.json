        {
          "name": "Return 404 for missing template",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/templates/999999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "templates",
                "999999999"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Missing template returns 404', () => pm.response.to.have.status(404));"
                ]
